# Terraform working directory and local state
**/.terraform/*
*.tfstate
*.tfstate.*

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform plans and crash logs
*.tfplan
crash.log
crash.*.log

# Local CLI configuration
.terraformrc
terraform.rc

# Keep provider lock files tracked for reproducible installs
!**/.terraform.lock.hcl